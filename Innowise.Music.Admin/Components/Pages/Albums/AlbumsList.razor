@page "/albums"
@attribute [Authorize]
@inject IAdminMusicService MusicService
@inject NavigationManager Navigation
@inject IAuthService AuthService
@layout MainLayout

<PageTitle>Albums - Admin Dashboard</PageTitle>

<div class="page-header">
        <h1>Albums Management</h1>
        <a href="/albums/new" class="btn-primary">+ Add Album</a>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading albums...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="error-state">
            <p>⚠️ @errorMessage</p>
            <button class="btn-primary" @onclick="LoadAlbums">Retry</button>
        </div>
    }
    else if (albums == null || !albums.Any())
    {
        <div class="empty-state">
            <p>No albums found</p>
            <a href="/albums/new" class="btn-primary">Add First Album</a>
        </div>
    }
    else
    {
        <div class="content-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Cover</th>
                        <th>Title</th>
                        <th>Artist</th>
                        <th>Release Date</th>
                        <th>Tracks</th>
                        <th>Genre</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var album in albums)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(album.ImageUrl))
                                {
                                    <img src="@album.ImageUrl" alt="@album.Title" class="album-cover" />
                                }
                                else
                                {
                                    <div class="album-cover-placeholder">🎵</div>
                                }
                            </td>
                            <td><strong>@album.Title</strong></td>
                            <td>@album.ArtistName</td>
                            <td>@(album.ReleaseDate?.ToString("MMM dd, yyyy") ?? "TBD")</td>
                            <td>@album.TrackCount</td>
                            <td>@(album.GenreName ?? "—")</td>
                            <td>
                                <div class="actions">
                                    <a href="/albums/@album.Id/edit" class="btn-action">Edit</a>
                                    <button class="btn-action btn-danger" @onclick="() => ConfirmDelete(album)">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (showDeleteDialog && deleteAlbum != null)
    {
        <div class="modal-overlay" @onclick="CloseDeleteDialog">
            <div class="modal-content" @onclick:stopPropagation>
                <h3>Delete Album</h3>
                <p>Are you sure you want to delete <strong>@deleteAlbum.Title</strong>? This will also delete all associated tracks.</p>
                <div class="modal-actions">
                    <button class="btn-secondary" @onclick="CloseDeleteDialog">Cancel</button>
                    <button class="btn-primary" style="background-color: var(--error-color);" @onclick="DeleteAlbum">Delete</button>
                </div>
            </div>
        </div>
    }

@code {
    private List<AlbumViewModel> albums = new();
    private bool isLoading;
    private string? errorMessage;
    private bool showDeleteDialog;
    private AlbumViewModel? deleteAlbum;

    protected override async Task OnInitializedAsync()
    {
        await LoadAlbums();
    }

    private async Task LoadAlbums()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var pagedResponse = await MusicService.GetAllAlbumsAsync();
            var albumDtos = pagedResponse.Items;
            albums = albumDtos.Select(a => new AlbumViewModel
            {
                Id = a.Id,
                Title = a.Title,
                ArtistId = a.ArtistId,
                ArtistName = a.Artist?.Name ?? "Unknown",
                ImageUrl = a.CoverImageUrl,
                ReleaseDate = a.ReleaseDate,
                GenreId = null,
                GenreName = a.Genre,
                TrackCount = a.TotalTracks
            }).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load albums: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ConfirmDelete(AlbumViewModel album)
    {
        deleteAlbum = album;
        showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        showDeleteDialog = false;
        deleteAlbum = null;
    }

    private async Task DeleteAlbum()
    {
        if (deleteAlbum == null) return;

        try
        {
            await MusicService.DeleteAlbumAsync(deleteAlbum.Id);
            albums.Remove(deleteAlbum);
            CloseDeleteDialog();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete album: {ex.Message}";
        }
    }

    // View model for combining album data with related entities
    private class AlbumViewModel
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public Guid ArtistId { get; set; }
        public string ArtistName { get; set; } = string.Empty;
        public string? ImageUrl { get; set; }
        public DateOnly? ReleaseDate { get; set; }
        public Guid? GenreId { get; set; }
        public string? GenreName { get; set; }
        public int TrackCount { get; set; }

    }
}
