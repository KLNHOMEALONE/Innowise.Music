@page "/genres/new"
@page "/genres/{id:guid}/edit"
@attribute [Authorize]
@inject IAdminMusicService MusicService
@inject NavigationManager Navigation
@inject IAuthService AuthService
@layout MainLayout

<div class="page-header">
        <h1>@(IsEditMode ? "Edit Genre" : "Add New Genre")</h1>
        <a href="/genres" class="btn-secondary">Back to List</a>
    </div>

    <div class="content-card">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message" style="background-color: #fee2e2; border: 1px solid #fecaca; color: #dc2626; padding: 12px; border-radius: 8px; margin-bottom: 16px;">
                ⚠️ @errorMessage
            </div>
        }
        <form @onsubmit="HandleSubmit" class="form">
            <div class="form-group">
                <label for="name">Name <span class="required">*</span></label>
                <input type="text" id="name" @bind="genre.Name" class="form-control" required />
                @if (!string.IsNullOrEmpty(nameError))
                {
                    <span class="error-text">@nameError</span>
                }
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" @bind="genre.Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="color">Color (Hex)</label>
                    <div class="color-input-group">
                        <input type="text" id="color" @bind="genre.Color" class="form-control" placeholder="#000000" maxlength="7" />
                        <input type="color" value="@colorPreview" @oninput="OnColorChange" class="color-picker" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="imageUrl">Image URL</label>
                    <input type="url" id="imageUrl" @bind="genre.ImageUrl" class="form-control" placeholder="https://..." />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary" disabled="@isSubmitting">
                    @(isSubmitting ? "Saving..." : "Save")
                </button>
                <a href="/genres" class="btn-secondary">Cancel</a>
            </div>
        </form>
    </div>

@code {
    [Parameter]
    public Guid? id { get; set; }

    private Genre genre = new();
    private bool isSubmitting;
    private string nameError = string.Empty;
    private string? errorMessage;
    private string colorPreview = "#000000";

    private bool IsEditMode => id.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (IsEditMode && id.HasValue)
        {
            var fetchedGenre = await MusicService.GetGenreAsync(id.Value);
            if (fetchedGenre != null)
            {
                genre = fetchedGenre;
                colorPreview = !string.IsNullOrEmpty(genre.Color) ? genre.Color : "#000000";
            }
            else
            {
                Navigation.NavigateTo("/genres");
            }
        }
    }

    private void OnColorChange(ChangeEventArgs e)
    {
        if (e.Value != null)
        {
            colorPreview = e.Value.ToString();
            genre.Color = colorPreview;
        }
    }

    private async Task HandleSubmit()
    {
        nameError = string.Empty;
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(genre.Name))
        {
            nameError = "Name is required";
            return;
        }

        isSubmitting = true;

        try
        {
            if (IsEditMode)
            {
                var result = await MusicService.UpdateGenreAsync(id!.Value, genre);
                if (result == null)
                {
                    errorMessage = "Failed to update genre. A genre with this name may already exist.";
                    return;
                }
            }
            else
            {
                var result = await MusicService.CreateGenreAsync(genre);
                if (result == null)
                {
                    errorMessage = "Failed to create genre. A genre with this name may already exist.";
                    return;
                }
            }
            Navigation.NavigateTo("/genres");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving genre: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
