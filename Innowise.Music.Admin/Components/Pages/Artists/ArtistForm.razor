@page "/artists/new"
@page "/artists/{id:guid}/edit"
@attribute [Authorize]
@inject IAdminMusicService MusicService
@inject NavigationManager Navigation
@inject IAuthService AuthService
@layout MainLayout

<PageTitle>@(IsEditMode ? "Edit Artist" : "Add New Artist")</PageTitle>

<div class="page-header">
    <h1>@(IsEditMode ? "Edit Artist" : "Add New Artist")</h1>
    <a href="/artists" class="btn-secondary">Back to List</a>
</div>

<div class="content-card">
    <EditForm Model="artist" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label for="name">Name <span class="required">*</span></label>
            <InputText id="name" @bind-Value="artist.Name" class="form-control" />
            <ValidationMessage For="@(() => artist.Name)" />
        </div>

        <div class="form-group">
            <label for="imageUrl">Image URL</label>
            <InputText id="imageUrl" @bind-Value="artist.ImageUrl" class="form-control" placeholder="https://..." />
        </div>

        <div class="form-group">
            <label for="biography">Biography</label>
            <InputTextArea id="biography" @bind-Value="artist.Biography" class="form-control" rows="5" placeholder="Tell us about the artist..." />
        </div>

        <div class="form-group">
            <label>
                <InputCheckbox id="verified" @bind-Value="artist.Verified" />
                Verified Artist
            </label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary" disabled="@isSubmitting">
                @(isSubmitting ? "Saving..." : "Save")
            </button>
            <a href="/artists" class="btn-secondary">Cancel</a>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public Guid? id { get; set; }

    private Artist artist = new();
    private bool isSubmitting;

    private bool IsEditMode => id.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (IsEditMode && id.HasValue)
        {
            var fetchedArtist = await MusicService.GetArtistAsync(id.Value);
            if (fetchedArtist != null)
            {
                artist = fetchedArtist;
            }
            else
            {
                Navigation.NavigateTo("/artists");
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;

        try
        {
            if (IsEditMode)
            {
                await MusicService.UpdateArtistAsync(id!.Value, artist);
            }
            else
            {
                await MusicService.CreateArtistAsync(artist);
            }
            Navigation.NavigateTo("/artists");
        }
        catch (Exception ex)
        {
            // Could show error message to user
            Console.WriteLine($"Error saving artist: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
