@page "/login"
@layout LoginLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<Login> Logger
@inject IJSRuntime JS

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h1 class="login-title">🎵 Innowise.Music</h1>
            <p class="login-subtitle">Admin Dashboard</p>
        </div>

        <form @onsubmit="HandleLogin" class="login-form">
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" @bind="email" class="form-control" placeholder="Enter your email" required />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" @bind="password" class="form-control" placeholder="Enter your password" required />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">@errorMessage</div>
            }

            <button type="submit" class="btn-login" disabled="@isLoggingIn">
                @if (isLoggingIn)
                {
                    <span>Logging in...</span>
                }
                else
                {
                    <span>Login</span>
                }
            </button>
        </form>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoggingIn;

    private async Task HandleLogin()
    {
        // Debug: Log to browser console to verify form submission
        await JS.InvokeVoidAsync("console.log", "HandleLogin called in Blazor!");
        Logger.LogInformation("HandleLogin called with email={Email}, password length={PasswordLength}", email, password?.Length);

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Please enter email and password";
            return;
        }

        isLoggingIn = true;
        errorMessage = string.Empty;
        StateHasChanged();

        Logger.LogInformation("Calling AuthService.LoginAsync");
        var success = await AuthService.LoginAsync(email, password);
        Logger.LogInformation("LoginAsync returned: success={Success}", success);

        isLoggingIn = false;

        if (success)
        {
            Logger.LogInformation("Login successful, checking admin status");
            var isAdmin = await AuthService.IsAdminAsync();
            Logger.LogInformation("IsAdminAsync returned: isAdmin={IsAdmin}", isAdmin);

            if (isAdmin)
            {
                Logger.LogInformation("User is admin, navigating to dashboard");
                try
                {
                    Navigation.NavigateTo("/", forceLoad: false);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Navigation to dashboard failed");
                    errorMessage = "Login successful but navigation failed. Please try again.";
                    StateHasChanged();
                    return;
                }
                return; // Important: return to avoid StateHasChanged and clearing fields
            }
            else
            {
                Logger.LogWarning("User is not admin, logging out. Token: {Token}", AuthService.GetToken());
                await AuthService.LogoutAsync();
                errorMessage = "Access denied. Admin privileges required.";
            }
        }
        else
        {
            Logger.LogInformation("Login failed, showing error");
            errorMessage = "Invalid email or password";
        }

        StateHasChanged();
    }
}
