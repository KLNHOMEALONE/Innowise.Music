@page "/"
@page "/dashboard"
@attribute [Authorize]
@inject IAdminMusicService MusicService
@layout MainLayout

<div class="dashboard-page">
    <div class="dashboard-header">
        <h1>Dashboard</h1>
        <p class="dashboard-subtitle">Welcome to Innowise.Music Admin Dashboard</p>
    </div>

    <div class="dashboard-stats">
        <div class="stat-card">
            <div class="stat-icon artists">🎤</div>
            <div class="stat-info">
                <h3>Artists</h3>
                <p class="stat-value">@artistCount</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon albums">💿</div>
            <div class="stat-info">
                <h3>Albums</h3>
                <p class="stat-value">@albumCount</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon tracks">🎵</div>
            <div class="stat-info">
                <h3>Tracks</h3>
                <p class="stat-value">@trackCount</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon genres">🎭</div>
            <div class="stat-info">
                <h3>Genres</h3>
                <p class="stat-value">@genreCount</p>
            </div>
        </div>
    </div>

    <div class="dashboard-actions">
        <h2>Quick Actions</h2>
        <div class="action-buttons">
            <a href="/artists" class="action-btn">
                <span class="btn-icon">➕</span>
                <span>Add Artist</span>
            </a>
            <a href="/albums" class="action-btn">
                <span class="btn-icon">➕</span>
                <span>Add Album</span>
            </a>
            <a href="/tracks" class="action-btn">
                <span class="btn-icon">➕</span>
                <span>Add Track</span>
            </a>
            <a href="/genres" class="action-btn">
                <span class="btn-icon">➕</span>
                <span>Add Genre</span>
            </a>
        </div>
    </div>
</div>

@code {
    private int artistCount;
    private int albumCount;
    private int trackCount;
    private int genreCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardStats();
    }

    private async Task LoadDashboardStats()
    {
        try
        {
            var artistsResponse = await MusicService.GetAllArtistsAsync(page: 1, pageSize: 1);
            artistCount = artistsResponse.TotalCount;

            var albumsResponse = await MusicService.GetAllAlbumsAsync(page: 1, pageSize: 1);
            albumCount = albumsResponse.TotalCount;

            var tracksResponse = await MusicService.GetAllTracksAsync(page: 1, pageSize: 1);
            trackCount = tracksResponse.TotalCount;

            var genres = await MusicService.GetAllGenresAsync();
            genreCount = genres.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard stats: {ex.Message}");
        }
    }
}
