@page "/tracks/upload-multi"
@attribute [Authorize]
@inject IAdminMusicService MusicService
@inject IMetadataExtractionService MetadataService
@inject NavigationManager Navigation
@inject IAuthService AuthService
@layout MainLayout
@using Innowise.Music.Admin.Models
@using Innowise.Music.Admin.Components.Pages.Tracks.Components
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Upload Tracks - Admin Dashboard</PageTitle>

<div class="page-header">
    <h1>Upload Multiple Tracks</h1>
    <a href="/tracks" class="btn-secondary">← Back to Tracks</a>
</div>

<UploadResult ErrorMessage="errorMessage" UploadComplete="uploadComplete" Result="uploadResult" Reset="ResetUpload" />

@if (string.IsNullOrEmpty(errorMessage) && !uploadComplete && showPreview)
{
    <MetadataPreview Tracks="extractedTracks"
                     Artists="artists"
                     Albums="albums"
                     Genres="genres"
                     Cancel="ResetUpload"
                     Upload="UploadTracks"
                     OnTrackGenreChanged="OnTrackGenreChangedAsync" />
}
else if (string.IsNullOrEmpty(errorMessage) && !uploadComplete && !showPreview)
{
    <UploadZone Files="selectedFiles"
                OnChange="HandleFileSelectionAsync"
                OnRemove="RemoveFileAsync"
                ClearAllFiles="ResetUpload"
                ExtractMetadata="ExtractMetadata"
                IsExtracting="isExtracting"
                CanExtract="CanExtract" />
}

<style>
    .upload-zone {
        border: 2px dashed var(--primary-color);
        border-radius: 12px;
        padding: 48px;
        text-align: center;
        transition: all 0.3s ease;
        background: rgba(var(--primary-rgb), 0.05);
    }

    .upload-icon {
        font-size: 64px;
        margin-bottom: 16px;
    }

    .browse-button {
        display: inline-block;
        padding: 12px 24px;
        background: var(--primary-color);
        color: white;
        border-radius: 8px;
        cursor: pointer;
        margin-top: 16px;
        transition: background 0.3s;
        text-decoration: none;
        font-size: 14px;
        border: none;
    }

    .browse-button:hover {
        background: var(--primary-dark);
    }

    /* Style the InputFile component */
    ::deep input[type="file"] {
        padding: 12px;
        background: var(--card-bg);
        border-radius: 8px;
        border: 1px solid var(--border-color);
        cursor: pointer;
        font-size: 14px;
    }

    ::deep input[type="file"]:hover {
        border-color: var(--primary-color);
    }

    .upload-info {
        margin-top: 24px;
        color: var(--text-secondary);
        font-size: 14px;
    }

    .selected-files {
        margin-top: 24px;
    }

    .file-list {
        list-style: none;
        padding: 0;
        max-height: 200px;
        overflow-y: auto;
    }

    .file-list li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 12px;
        border-bottom: 1px solid var(--border-color);
    }

    .btn-remove {
        background: none;
        border: none;
        color: var(--error-color);
        font-size: 20px;
        cursor: pointer;
        padding: 0 8px;
    }

    .tracks-preview {
        display: flex;
        flex-direction: column;
        gap: 24px;
        margin-top: 24px;
    }

    .track-preview-card {
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 20px;
        background: var(--card-bg);
    }

    .track-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-color);
    }

    .validation-warning {
        color: var(--warning-color);
        font-size: 14px;
    }

    .track-fields {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .field-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .field-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .form-input, .form-select {
        padding: 10px 12px;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        font-size: 14px;
    }

    .checkbox-group {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }

    .upload-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 24px;
        padding-top: 24px;
        border-top: 1px solid var(--border-color);
    }

    .success-state {
        text-align: center;
        padding: 48px;
    }

    .success-state h2 {
        color: var(--success-color);
        margin-bottom: 16px;
    }

    .warning {
        color: var(--warning-color);
    }

    .error-text {
        color: var(--error-color);
        text-align: left;
        margin: 4px 0;
    }

    .action-buttons {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-top: 24px;
    }
</style>

@code {
    private List<ExtractedTrackMetadata> extractedTracks = new();
    private List<Models.Artist> artists = new();
    private List<Models.Album> albums = new();
    private List<Models.Genre> genres = new();
    private bool showPreview;
    private bool uploadComplete;
    private string? errorMessage;
    private BatchUploadResult uploadResult = new();

    // File selection
    private List<SelectedFile> selectedFiles = new();
    private const long MaxFileSize = 50 * 1024 * 1024; // 50MB
    private const int MaxFiles = 30;

    private bool isExtracting;
    private bool CanExtract => selectedFiles.Any() && !isExtracting;

    protected override async Task OnInitializedAsync()
    {
        await LoadExistingEntities();
    }

    private async Task LoadExistingEntities()
    {
        try
        {
            var artistsResponse = await MusicService.GetAllArtistsAsync();
            artists = artistsResponse.Items.ToList();

            var albumsResponse = await MusicService.GetAllAlbumsAsync();
            albums = albumsResponse.Items.ToList();

            genres = await MusicService.GetAllGenresAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load existing entities: {ex.Message}";
        }
    }

    private async Task HandleFileSelectionAsync(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        var files = e.GetMultipleFiles();

        if (selectedFiles.Count + files.Count > MaxFiles)
        {
            errorMessage = $"Maximum {MaxFiles} files allowed per batch";
            await InvokeAsync(StateHasChanged);
            return;
        }

        foreach (var file in files)
        {
            var extension = Path.GetExtension(file.Name).ToLower();
            if (!new[] { ".mp3", ".wav", ".flac", ".aac" }.Contains(extension))
            {
                errorMessage = $"Unsupported file type: {file.Name}";
                continue;
            }

            if (file.Size > MaxFileSize)
            {
                errorMessage = $"File too large: {file.Name} (max 50MB)";
                continue;
            }

            selectedFiles.Add(new SelectedFile
            {
                Name = file.Name,
                Length = file.Size,
                BrowserFile = file
            });
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveFileAsync(SelectedFile file)
    {
        selectedFiles.Remove(file);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ExtractMetadata()
    {
        errorMessage = null;
        isExtracting = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var fileStreams = new List<(Stream stream, string name)>();
            foreach (var file in selectedFiles)
            {
                if (file.BrowserFile != null)
                {
                    var stream = file.BrowserFile.OpenReadStream(MaxFileSize);
                    fileStreams.Add((stream, file.Name));
                }
            }

            extractedTracks = await Task.Run(async () =>
                (await MetadataService.ExtractMetadataBatchAsync(
                    fileStreams.Select(f => (f.stream, f.name)))).ToList());

            foreach (var track in extractedTracks)
            {
                if (track.Performers.Any())
                {
                    var matchedArtist = artists.FirstOrDefault(a =>
                        a.Name.Equals(track.Performers.First(), StringComparison.OrdinalIgnoreCase));
                    if (matchedArtist != null)
                    {
                        track.MatchedArtistId = matchedArtist.Id;
                        track.MatchedArtistName = matchedArtist.Name;
                    }
                    else
                    {
                        track.MatchedArtistName = track.Performers.First();
                    }
                }

                if (!string.IsNullOrWhiteSpace(track.Album))
                {
                    var matchedAlbum = albums.FirstOrDefault(a =>
                        a.Title.Equals(track.Album, StringComparison.OrdinalIgnoreCase));
                    if (matchedAlbum != null)
                    {
                        track.MatchedAlbumId = matchedAlbum.Id;
                        track.MatchedAlbumName = matchedAlbum.Title;
                    }
                    else
                    {
                        track.MatchedAlbumName = track.Album;
                    }
                }

                if (track.Genres.Any())
                {
                    var matchedGenreIds = new List<Guid>();
                    foreach (var genreName in track.Genres)
                    {
                        var matchedGenre = genres.FirstOrDefault(g =>
                            g.Name.Equals(genreName, StringComparison.OrdinalIgnoreCase));
                        if (matchedGenre != null)
                        {
                            matchedGenreIds.Add(matchedGenre.Id);
                        }
                    }
                    track.MatchedGenreIds = matchedGenreIds.ToArray();
                }
            }

            showPreview = true;
            isExtracting = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            isExtracting = false;
            errorMessage = $"Failed to extract metadata: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnTrackGenreChangedAsync(GenreChange change)
    {
        if (change.IsChecked)
        {
            if (!change.Track.MatchedGenreIds.Contains(change.GenreId))
            {
                change.Track.MatchedGenreIds = change.Track.MatchedGenreIds.Append(change.GenreId).ToArray();
            }
        }
        else
        {
            if (change.Track.MatchedGenreIds.Contains(change.GenreId))
            {
                change.Track.MatchedGenreIds = change.Track.MatchedGenreIds.Except(new[] { change.GenreId }).ToArray();
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task UploadTracks()
    {
        errorMessage = null;
        uploadComplete = false;

        try
        {
            var uploadDtos = new List<TrackUploadDto>();

            foreach (var track in extractedTracks)
            {
                if (!track.IsValid) continue;

                uploadDtos.Add(new TrackUploadDto
                {
                    FileName = track.FileName,
                    AudioData = track.AudioData,
                    Title = track.Title,
                    ArtistName = track.MatchedArtistName ?? track.Performers.FirstOrDefault() ?? "Unknown",
                    ArtistId = track.MatchedArtistId,
                    AlbumName = track.MatchedAlbumName,
                    AlbumId = track.MatchedAlbumId,
                    Genres = track.MatchedGenreIds.Any() ? null :
                            track.Genres.Any() ? track.Genres :
                            track.GenresString?.Split(',').Select(g => g.Trim()).Where(g => !string.IsNullOrWhiteSpace(g)).ToArray(),
                    GenreIds = track.MatchedGenreIds.Any() ? track.MatchedGenreIds : null,
                    Duration = track.Duration,
                    TrackNumber = track.TrackNumber > 0 ? (int?)track.TrackNumber : null,
                    Bitrate = track.Bitrate > 0 ? track.Bitrate : null,
                    SampleRate = track.SampleRate > 0 ? track.SampleRate : null,
                    FileSize = track.FileSize,
                    AudioFormat = track.AudioFormat,
                    Year = track.Year > 0 ? track.Year : null
                });
            }

            if (!uploadDtos.Any())
            {
                var invalidCount = extractedTracks.Count(t => !t.IsValid);
                errorMessage = $"No valid tracks to upload. {invalidCount} track(s) failed validation (missing title, duration, or audio data).";
                await InvokeAsync(StateHasChanged);
                return;
            }

            uploadResult = await MusicService.UploadTracksBatchAsync(uploadDtos);
            errorMessage = null;
            uploadComplete = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            errorMessage = $"Upload failed: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ResetUpload()
    {
        selectedFiles.Clear();
        extractedTracks.Clear();
        showPreview = false;
        uploadComplete = false;
        errorMessage = null;
        uploadResult = new BatchUploadResult();
        await InvokeAsync(StateHasChanged);
    }
}
