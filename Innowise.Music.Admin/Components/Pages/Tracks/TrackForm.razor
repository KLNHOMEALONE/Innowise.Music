@page "/tracks/new"
@page "/tracks/{id:guid}/edit"
@attribute [Authorize]
@inject IAdminMusicService MusicService
@inject NavigationManager Navigation
@inject IAuthService AuthService
@layout MainLayout

<PageTitle>@(IsEditMode ? "Edit Track" : "Add New Track")</PageTitle>

<div class="page-header">
    <h1>@(IsEditMode ? "Edit Track" : "Add New Track")</h1>
    <a href="/tracks" class="btn-secondary">Back to List</a>
</div>

<div class="content-card">
    <EditForm Model="track" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label for="title">Title <span class="required">*</span></label>
            <InputText id="title" @bind-Value="track.Title" class="form-control" />
            <ValidationMessage For="@(() => track.Title)" />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="artistId">Artist <span class="required">*</span></label>
                <InputSelect id="artistId" @bind-Value="track.ArtistId" class="form-control">
                    <option value="">-- Select Artist --</option>
                    @foreach (var artist in artists)
                    {
                        <option value="@artist.Id">@artist.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => track.ArtistId)" />
            </div>
            <div class="form-group">
                <label for="albumId">Album</label>
                <InputSelect id="albumId" @bind-Value="track.AlbumId" class="form-control">
                    <option value="">-- Select Album (Optional) --</option>
                    @foreach (var album in albums)
                    {
                        <option value="@album.Id">@album.Title</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="trackNumber">Track Number</label>
                <InputNumber id="trackNumber" @bind-Value="track.TrackNumber" class="form-control" min="1" />
            </div>
            <div class="form-group">
                <label for="duration">Duration (seconds)</label>
                <InputNumber id="duration" @bind-Value="track.Duration" class="form-control" min="1" />
            </div>
        </div>

        <div class="form-group">
            <label>Genres</label>
            <div class="checkbox-group">
                @foreach (var genre in genres)
                {
                    <label class="checkbox-label">
                        <input type="checkbox" value="@genre.Id" checked="@(selectedGenreIds.Contains(genre.Id))" @onchange="e => OnGenreChanged(genre.Id, e)" />
                        @genre.Name
                    </label>
                }
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="audioFormat">Audio Format</label>
                <InputSelect id="audioFormat" @bind-Value="track.AudioFormat" class="form-control">
                    <option value="MP3">MP3</option>
                    <option value="WAV">WAV</option>
                    <option value="FLAC">FLAC</option>
                    <option value="AAC">AAC</option>
                </InputSelect>
            </div>
            <div class="form-group">
                <label>
                    <InputCheckbox @bind-Value="track.Explicit" />
                    Explicit Content
                </label>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary" disabled="@isSubmitting">
                @(isSubmitting ? "Saving..." : "Save")
            </button>
            <a href="/tracks" class="btn-secondary">Cancel</a>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public Guid? id { get; set; }

    private Track track = new();
    private List<Artist> artists = new();
    private List<Album> albums = new();
    private List<Genre> genres = new();
    private Guid[] selectedGenreIds = Array.Empty<Guid>();
    private bool isSubmitting;

    private bool IsEditMode => id.HasValue;

    protected override async Task OnInitializedAsync()
    {
        // Load dropdown data
        try
        {
            var artistsTask = MusicService.GetAllArtistsAsync();
            var albumsTask = MusicService.GetAllAlbumsAsync();
            var genresTask = MusicService.GetAllGenresAsync();
            await Task.WhenAll(artistsTask, albumsTask, genresTask);

            artists = artistsTask.Result.Items.ToList();
            albums = albumsTask.Result.Items.ToList();
            genres = genresTask.Result;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dropdown data: {ex.Message}");
        }

        if (IsEditMode && id.HasValue)
        {
            var fetchedTrack = await MusicService.GetTrackAsync(id.Value);
            if (fetchedTrack != null)
            {
                track = fetchedTrack;
                selectedGenreIds = track.Genres?.Select(g => g.Id).Where(g => g != Guid.Empty).ToArray() ?? Array.Empty<Guid>();
            }
            else
            {
                Navigation.NavigateTo("/tracks");
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        if (track.Duration <= 0)
        {
            track.Duration = 180; // Default 3 minutes
        }

        track.Genres = genres.Where(g => selectedGenreIds.Contains(g.Id)).ToList();

        isSubmitting = true;

        try
        {
            if (IsEditMode)
            {
                await MusicService.UpdateTrackAsync(id!.Value, track);
            }
            else
            {
                await MusicService.CreateTrackAsync(track);
            }
            Navigation.NavigateTo("/tracks");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving track: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OnGenreChanged(Guid genreId, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            if (!selectedGenreIds.Contains(genreId))
            {
                selectedGenreIds = selectedGenreIds.Append(genreId).ToArray();
            }
        }
        else
        {
            if (selectedGenreIds.Contains(genreId))
            {
                selectedGenreIds = selectedGenreIds.Except(new[] { genreId }).ToArray();
            }
        }
    }
}
