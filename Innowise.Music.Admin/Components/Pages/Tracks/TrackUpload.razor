@page "/tracks/{id:guid}/upload"
@inject IAdminMusicService MusicService
@inject NavigationManager Navigation

<PageTitle>Upload Audio - Admin Dashboard</PageTitle>

<div class="page-header">
    <h1>Upload Audio for "@track?.Title"</h1>
    <a href="tracks" class="btn-secondary">Back to Tracks</a>
</div>

@if (isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading track information...</p>
    </div>
}
else if (errorMessage != null)
{
    <div class="error-state">
        <p>⚠️ @errorMessage</p>
        <button class="btn-primary" @onclick="LoadTrack">Retry</button>
    </div>
}
else if (track != null)
{
    <div class="content-card">
        <div class="track-info">
            <h3>Track Details</h3>
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Title:</span>
                    <span class="info-value">@track.Title</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Artist:</span>
                    <span class="info-value">@track.Artist?.Name</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Album:</span>
                    <span class="info-value">@(track.Album?.Title ?? "—")</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Duration:</span>
                    <span class="info-value">@track.Duration.ToString(@"m\:ss")</span>
                </div>
            </div>
        </div>

        <div class="upload-section">
            <h3>Upload Audio File</h3>
            
            <div class="upload-requirements">
                <h4>Requirements:</h4>
                <ul>
                    <li>Supported formats: MP3, WAV, FLAC, AAC</li>
                    <li>Maximum file size: 50MB</li>
                    <li>Recommended bitrate: 320 kbps or higher</li>
                </ul>
            </div>

            <div class="upload-area">
                <InputFile
                    OnChange="HandleFileSelect"
                    accept=".mp3,.wav,.flac,.aac,audio/mpeg,audio/wav,audio/flac,audio/aac"
                    class="file-input" />
                
                @if (selectedFile != null)
                {
                    <div class="file-info">
                        <span class="file-name">@selectedFile.Name</span>
                        <span class="file-size">(@FormatFileSize(selectedFile.Size))</span>
                    </div>
                }
                else
                {
                    <p class="upload-hint">Click to select file</p>
                }
            </div>

            @if (uploadProgress > 0)
            {
                <div class="progress-section">
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: @uploadProgress%"></div>
                    </div>
                    <span class="progress-text">@uploadProgress% complete</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(uploadError))
            {
                <div class="error-message">
                    ⚠️ @uploadError
                </div>
            }

            @if (uploadSuccess)
            {
                <div class="success-message">
                    ✓ Audio file uploaded successfully!
                </div>
            }

            <div class="form-actions">
                <button type="button" class="btn-primary" @onclick="UploadFile" disabled="@(selectedFile == null || isUploading)">
                    @(isUploading ? "Uploading..." : "Upload Audio")
                </button>
                <a href="tracks" class="btn-secondary">Cancel</a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid id { get; set; }

    private Track? track;
    private IBrowserFile? selectedFile;
    private bool isLoading;
    private bool isUploading;
    private string? errorMessage;
    private string? uploadError;
    private bool uploadSuccess;
    private int uploadProgress;

    private const long MaxFileSize = 50 * 1024 * 1024; // 50MB
    private static readonly string[] AllowedExtensions = { ".mp3", ".wav", ".flac", ".aac" };

    protected override async Task OnInitializedAsync()
    {
        await LoadTrack();
    }

    private async Task LoadTrack()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            track = await MusicService.GetTrackAsync(id);
            if (track == null)
            {
                Navigation.NavigateTo("/tracks");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load track: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task HandleFileSelect(InputFileChangeEventArgs e)
    {
        var file = e.File;
        
        // Validate file extension
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (!AllowedExtensions.Contains(extension))
        {
            uploadError = $"Invalid file type. Allowed: {string.Join(", ", AllowedExtensions)}";
            return Task.CompletedTask;
        }

        // Validate file size
        if (file.Size > MaxFileSize)
        {
            uploadError = $"File too large. Maximum size: {FormatFileSize(MaxFileSize)}";
            return Task.CompletedTask;
        }

        selectedFile = file;
        uploadError = null;
        uploadSuccess = false;
        uploadProgress = 0;

        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task UploadFile()
    {
        if (selectedFile == null || track == null) return;

        isUploading = true;
        uploadError = null;
        uploadSuccess = false;
        uploadProgress = 0;

        try
        {
            using var fileStream = selectedFile.OpenReadStream(MaxFileSize);
            var result = await MusicService.UploadTrackAudioAsync(id, fileStream, selectedFile.Name);

            if (result)
            {
                uploadSuccess = true;
                uploadProgress = 100;
                
                // Navigate back after a short delay
                await Task.Delay(2000);
                Navigation.NavigateTo("/tracks");
            }
            else
            {
                uploadError = "Upload failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            uploadError = $"Upload error: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        
        return $"{len:0.##} {sizes[order]}";
    }
}
