@using Microsoft.AspNetCore.Components.Web
@page "/tracks"
@attribute [Authorize]
@inject IAdminMusicService MusicService
@inject NavigationManager Navigation
@inject IAuthService AuthService
@layout MainLayout

<PageTitle>Tracks - Admin Dashboard</PageTitle>

<div class="page-header">
    <h1>Tracks Management</h1>
    <div class="header-actions">
        <a href="/tracks/upload-multi" class="btn-secondary">Add Tracks</a>
    </div>
</div>

@if (isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading tracks...</p>
    </div>
}
else if (errorMessage != null)
{
    <div class="error-state">
        <p>⚠️ @errorMessage</p>
        <button class="btn-primary" @onclick="LoadTracks">Retry</button>
    </div>
}
else if (tracks == null || !tracks.Any())
{
    <div class="empty-state">
        <p>No tracks found</p>
        <a href="/tracks/new" class="btn-primary">Add First Track</a>
    </div>
}
else
{
    <div class="content-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Artist</th>
                    <th>Album</th>
                    <th>Duration</th>
                    <th>Genre</th>
                    <th>Audio</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var track in tracks)
                {
                    <tr>
                        <td><strong>@track.Title</strong></td>
                        <td>@track.ArtistName</td>
                        <td>@(string.IsNullOrEmpty(track.AlbumName) ? "—" : track.AlbumName)</td>
                        <td>@FormatDuration(track.Duration)</td>
                        <td>
                            @if (track.Genres.Any())
                            {
                                <span>@string.Join(", ", track.Genres.Select(g => g.Name))</span>
                            }
                            else
                            {
                                <span class="status-badge status-warning">No genre</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(track.AudioFormat))
                            {
                                <span class="status-badge status-success">@track.AudioFormat</span>
                            }
                            else
                            {
                                <span class="status-badge status-warning">No audio</span>
                            }
                        </td>
                        <td>
                            <div class="actions">
                                <a href="/tracks/@track.Id/edit" class="btn-action">Edit</a>
                                <a href="/tracks/@track.Id/upload" class="btn-action">Upload</a>
                                <button class="btn-action btn-danger" @onclick="() => ConfirmDelete(track)">Delete</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (totalPages > 1)
        {
            var startItem = (currentPage - 1) * PageSize + 1;
            var endItem = Math.Min(currentPage * PageSize, totalCount);
            var pageInfo = $"Showing {startItem}-{endItem} of {totalCount} tracks";
            var pageNumbers = GetPageNumbers();
            var prevDisabled = !hasPrevious;
            var nextDisabled = !hasNext;

            <div class="pagination">
                <div class="pagination-info">
                    @pageInfo
                </div>
                <div class="pagination-controls">
                    <button class="btn-page" @onclick="PreviousPage" disabled="@prevDisabled">← Previous</button>

                    @foreach (var pageNum in pageNumbers)
                    {
                        if (pageNum > 0)
                        {
                            <button class="btn-page @(pageNum == currentPage ? "btn-page-active" : "")" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                        }
                        else
                        {
                            <span class="page-ellipsis">...</span>
                        }
                    }

                    <button class="btn-page" @onclick="NextPage" disabled="@nextDisabled">Next →</button>
                </div>
            </div>
        }
    </div>
}

@if (showDeleteDialog && deleteTrack != null)
{
    <div class="modal-overlay" @onclick="CloseDeleteDialog">
        <div class="modal-content" @onclick:stopPropagation>
            <h3>Delete Track</h3>
            <p>Are you sure you want to delete <strong>@deleteTrack.Title</strong>? This action cannot be undone.</p>
            <div class="modal-actions">
                <button class="btn-secondary" @onclick="CloseDeleteDialog">Cancel</button>
                <button class="btn-primary" style="background-color: var(--error-color);" @onclick="DeleteTrack">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<TrackViewModel> tracks = new();
    private bool isLoading;
    private string? errorMessage;
    private bool showDeleteDialog;
    private TrackViewModel? deleteTrack;

    // Pagination
    private int currentPage = 1;
    private const int PageSize = 20;
    private int totalCount;
    private int totalPages;
    private bool hasPrevious;
    private bool hasNext;

    protected override async Task OnInitializedAsync()
    {
        await LoadTracks();
    }

    private async Task LoadTracks()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var pagedResponse = await MusicService.GetAllTracksAsync(page: currentPage, pageSize: PageSize);
            tracks = pagedResponse.Items.Select(t => new TrackViewModel
            {
                Id = t.Id,
                Title = t.Title,
                ArtistId = t.ArtistId ?? Guid.Empty,
                ArtistName = t.Artist?.Name ?? "Unknown",
                AlbumId = t.AlbumId,
                AlbumName = t.Album?.Title,
                Duration = t.Duration,
                TrackNumber = t.TrackNumber,
                AudioFormat = t.AudioFormat,
                Genres = t.Genres?.ToList() ?? new List<Genre>(),
                Explicit = t.Explicit
            }).ToList();

            totalCount = pagedResponse.TotalCount;
            totalPages = pagedResponse.TotalPages;
            hasPrevious = pagedResponse.HasPrevious;
            hasNext = pagedResponse.HasNext;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load tracks: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadTracks();
    }

    private async Task PreviousPage()
    {
        if (hasPrevious)
        {
            await GoToPage(currentPage - 1);
        }
    }

    private async Task NextPage()
    {
        if (hasNext)
        {
            await GoToPage(currentPage + 1);
        }
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        for (int i = 1; i <= totalPages; i++)
        {
            if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
            {
                pages.Add(i);
            }
            else if (i == currentPage - 3 || i == currentPage + 3)
            {
                pages.Add(0); // Sentinel for ellipsis
            }
        }
        return pages;
    }

    private string FormatDuration(int durationSeconds)
    {
        var duration = TimeSpan.FromSeconds(durationSeconds);
        if (duration.TotalHours >= 1)
        {
            return duration.ToString(@"h\:mm\:ss");
        }
        return duration.ToString(@"m\:ss");
    }

    private void ConfirmDelete(TrackViewModel track)
    {
        deleteTrack = track;
        showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        showDeleteDialog = false;
        deleteTrack = null;
    }

    private async Task DeleteTrack()
    {
        if (deleteTrack == null) return;

        try
        {
            await MusicService.DeleteTrackAsync(deleteTrack.Id);
            tracks.Remove(deleteTrack);
            CloseDeleteDialog();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete track: {ex.Message}";
        }
    }

    // View model for combining track data with related entities
    private class TrackViewModel
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public Guid ArtistId { get; set; }
        public string ArtistName { get; set; } = string.Empty;
        public Guid? AlbumId { get; set; }
        public string? AlbumName { get; set; }
        public int Duration { get; set; }
        public int? TrackNumber { get; set; }
        public string AudioFormat { get; set; } = string.Empty;
        public List<Genre> Genres { get; set; } = new();
        public bool Explicit { get; set; }
    }
}
