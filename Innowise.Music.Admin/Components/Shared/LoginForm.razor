@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<LoginForm> Logger
@rendermode InteractiveServer

<div class="login-card">
    <div class="login-header">
        <h1 class="login-title">🎵 Innowise.Music</h1>
        <p class="login-subtitle">Admin Dashboard</p>
    </div>

    <form @onsubmit="HandleLogin" @onsubmit:preventDefault class="login-form">
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" @bind="email" class="form-control" placeholder="Enter your email" />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" @bind="password" class="form-control" placeholder="Enter your password" />
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error-message">@ErrorMessage</div>
        }

        <button type="submit" class="btn-login" disabled="@IsLoggingIn">
            @if (IsLoggingIn)
            {
                <span>Logging in...</span>
            }
            else
            {
                <span>Login</span>
            }
        </button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "logout")]
    public bool IsLogout { get; set; }

    private string email = string.Empty;
    private string password = string.Empty;
    public string ErrorMessage { get; set; } = string.Empty;
    public bool IsLoggingIn { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (IsLogout)
        {
            Logger.LogInformation("Logout requested, clearing authentication state");
            await AuthService.LogoutAsync();
        }
    }

    private async Task HandleLogin()
    {
        Logger.LogInformation("HandleLogin called with email={Email}, password length={PasswordLength}", email, password?.Length);

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            ErrorMessage = "Please enter email and password";
            StateHasChanged();
            return;
        }

        IsLoggingIn = true;
        ErrorMessage = string.Empty;
        StateHasChanged();

        Logger.LogInformation("Calling AuthService.LoginAsync");
        var success = await AuthService.LoginAsync(email, password);
        Logger.LogInformation("LoginAsync returned: success={Success}", success);

        IsLoggingIn = false;

        if (success)
        {
            Logger.LogInformation("Login successful, checking admin status");
            var isAdmin = await AuthService.IsAdminAsync();
            Logger.LogInformation("IsAdminAsync returned: isAdmin={IsAdmin}", isAdmin);
            Logger.LogInformation("Token from AuthService: {Token}", AuthService.GetToken()?.Substring(0, Math.Min(20, AuthService.GetToken()?.Length ?? 0)) + "...");

            if (isAdmin)
            {
                Logger.LogInformation("User is admin, navigating to dashboard");
                Navigation.NavigateTo("/", forceLoad: false);
                return;
            }
            else
            {
                Logger.LogWarning("User is not admin, logging out. Token: {Token}", AuthService.GetToken());
                await AuthService.LogoutAsync();
                ErrorMessage = "Access denied. Admin privileges required.";
            }
        }
        else
        {
            Logger.LogInformation("Login failed, showing error");
            ErrorMessage = "Invalid email or password";
        }

        StateHasChanged();
    }
}
