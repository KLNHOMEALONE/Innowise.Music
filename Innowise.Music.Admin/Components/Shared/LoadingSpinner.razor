@*
 * @file: LoadingSpinner.razor
 * @description: Reusable loading spinner component with optional message
 * @dependencies: None
 * @created: 2026-03-29
 *@

@if (IsVisible)
{
    <div class="loading-container @(IsOverlay ? "overlay" : "")">
        <div class="spinner"></div>
        @if (!string.IsNullOrEmpty(Message))
        {
            <p class="loading-message">@Message</p>
        }
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public string Message { get; set; } = "Loading...";

    [Parameter]
    public bool IsOverlay { get; set; } = false;
}
