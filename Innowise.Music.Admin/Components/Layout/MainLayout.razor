@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<MainLayout> Logger
@inject IJSRuntime JS

<div class="admin-layout">
    <NavMenu />
    <main class="main-content">
        <header class="admin-header">
            <h1 class="admin-title">Innowise.Music Admin</h1>
            <div class="header-actions">
                <span class="user-info">@UserName</span>
                <a href="/logout" class="btn-logout">Logout</a>
            </div>
        </header>
        <div class="page-content">
            @Body
        </div>
    </main>
</div>

@code {
    private string UserName => _userName ?? "Admin";
    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserInfo();
    }

    private async Task LoadUserInfo()
    {
        var token = AuthService.GetToken();
        if (!string.IsNullOrEmpty(token))
        {
            try
            {
                var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
                var jwtToken = handler.ReadJwtToken(token);
                var emailClaim = jwtToken.Claims.FirstOrDefault(c =>
                    c.Type == System.Security.Claims.ClaimTypes.Email ||
                    c.Type == "email")?.Value;
                
                _userName = emailClaim ?? "Admin";
            }
            catch
            {
                _userName = "Admin";
            }
        }
        else
        {
            _userName = "Admin";
        }
        
        StateHasChanged();
    }
}
