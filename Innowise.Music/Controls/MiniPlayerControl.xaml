<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Innowise.Music.ViewModel"
             x:Class="Innowise.Music.Controls.MiniPlayerControl"
             x:DataType="vm:MiniPlayerViewModel">
    <Border IsVisible="{Binding IsVisible}" BackgroundColor="{StaticResource InputBackgroundColor}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Margin="8,0,8,8" Padding="10">
        <Grid>
            <toolkit:MediaElement x:Name="mediaElement" IsVisible="False" />
            
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0" ColumnDefinitions="45, *, Auto">
                <Border Grid.Column="0" WidthRequest="45" HeightRequest="45" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                    <Image Source="{Binding CurrentTrack.ImageUrl}" Aspect="AspectFill" />
                </Border>
                
                <VerticalStackLayout Grid.Column="1" Margin="10,0" VerticalOptions="Center">
                    <Label Text="{Binding CurrentTrack.Title}" TextColor="White" FontAttributes="Bold" FontSize="14" />
                    <Label Text="{Binding CurrentTrack.ArtistName}" TextColor="Gray" FontSize="12" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="2" Spacing="20" VerticalOptions="Center">
                    <Border BackgroundColor="{Binding IsFavorite, Converter={StaticResource FavoriteBackgroundConverter}}" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding IsFavorite, Converter={StaticResource FavoriteTextConverter}}" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border BackgroundColor="White" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource PrimaryRed}" Offset="0,2" Radius="4" Opacity="0.3" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePlayPauseCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="▶" TextColor="{StaticResource PrimaryRed}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" Margin="3,0,0,0">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Text" Value="❚❚" />
                                    <Setter Property="FontSize" Value="14" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsPlaying}" Value="False">
                                    <Setter Property="Text" Value="▶" />
                                    <Setter Property="FontSize" Value="20" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <ProgressBar Grid.Row="1" Progress="{Binding Progress}" ProgressColor="{StaticResource PrimaryRed}" BackgroundColor="Gray" HeightRequest="2" Margin="-10,10,-10,-8" />
        </Grid>
    </Border>
</ContentView>
