<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Innowise.Music.ViewModel"
             xmlns:controls="clr-namespace:Innowise.Music.Controls"
             xmlns:converters="clr-namespace:Innowise.Music.Converters"
             x:Class="Innowise.Music.View.SearchPage"
             x:DataType="vm:SearchPageViewModel"
             BackgroundColor="{StaticResource Gray950}"
             Shell.NavBarIsVisible="False"
             Title="Search">

    <ContentPage.Resources>
        <converters:BoolToFavoriteIconConverter x:Key="BoolToFavoriteIconConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto, Auto">
        <!-- 1. Search Bar (Fixed at Top) -->
        <Border Grid.Row="0" 
                BackgroundColor="{StaticResource InputBackgroundColor}" 
                StrokeShape="RoundRectangle 8" 
                HeightRequest="50" 
                Margin="20,20,20,10" 
                Padding="15,0" 
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto, *">
                <Label Grid.Column="0" Text="🔍" VerticalOptions="Center" Margin="0,0,10,0" />
                <Entry Grid.Column="1" 
                       Text="{Binding SearchQuery}" 
                       Placeholder="What do you want to listen to?" 
                       PlaceholderColor="Gray"
                       TextColor="White"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- 2. Search Results Area (Scrollable Middle) -->
        <Grid Grid.Row="1" Padding="20,0">
            <CollectionView ItemsSource="{Binding SearchResults}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchResultItem">
                        <Grid ColumnDefinitions="50, *, Auto" Padding="0,10" ColumnSpacing="15">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Parent.PlayTrackCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Border Grid.Column="0" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" WidthRequest="50" HeightRequest="50" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Title}" TextColor="White" FontSize="16" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Subtitle}" TextColor="Gray" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Grid Grid.Column="2" ColumnDefinitions="Auto, Auto" ColumnSpacing="20" VerticalOptions="Center">
                                <Image Grid.Column="0"
                                       Source="{Binding IsFavorited, Converter={StaticResource BoolToFavoriteIconConverter}}" 
                                       WidthRequest="24" HeightRequest="24"
                                       IsVisible="{Binding IsTrack}">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Parent.ToggleFavoriteCommand}" CommandParameter="{Binding .}" />
                                    </Image.GestureRecognizers>
                                </Image>
                                <Label Grid.Column="1"
                                       Text="⋮" TextColor="White" FontSize="24" IsVisible="{Binding IsTrack}" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                        <Label Text="No results found" TextColor="Gray" FontSize="16" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Loading Overlay (Centered in results area) -->
            <Grid BackgroundColor="#40000000" IsVisible="{Binding IsSearching}" InputTransparent="False">
                <ActivityIndicator IsRunning="{Binding IsSearching}" Color="{StaticResource PrimaryRed}" VerticalOptions="Center" HorizontalOptions="Center" Scale="1.5" />
            </Grid>
        </Grid>

        <!-- 3. Pagination Bar (Fixed above Player) -->
        <Border Grid.Row="2" 
                BackgroundColor="{StaticResource Gray950}" 
                IsVisible="{Binding IsPaginationVisible}"
                Padding="20,10"
                StrokeThickness="0"
                VerticalOptions="End">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Button Grid.Column="0" 
                        Text="Previous" 
                        Command="{Binding PreviousPageCommand}"
                        BackgroundColor="{StaticResource InputBackgroundColor}"
                        TextColor="White"
                        CornerRadius="20"
                        FontSize="12"
                        HeightRequest="36"
                        Padding="15,0" />
                
                <Label Grid.Column="1" 
                       VerticalOptions="Center" 
                       HorizontalOptions="Center" 
                       TextColor="Gray"
                       FontSize="13">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Page " />
                            <Span Text="{Binding CurrentPage}" TextColor="White" FontAttributes="Bold" />
                            <Span Text=" of " />
                            <Span Text="{Binding TotalPages}" TextColor="White" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Button Grid.Column="2" 
                        Text="Next" 
                        Command="{Binding NextPageCommand}"
                        BackgroundColor="{StaticResource InputBackgroundColor}"
                        TextColor="White"
                        CornerRadius="20"
                        FontSize="12"
                        HeightRequest="36"
                        Padding="15,0" />
            </Grid>
        </Border>
        
        <!-- 4. Mini Player (Fixed at Very Bottom) -->
        <controls:MiniPlayerControl Grid.Row="3" />
    </Grid>
</ContentPage>
